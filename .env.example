# Local PostgreSQL provisioning, migrations/smoke and lazy server-only application access.
# See README: generate independent hex secrets in root ignored .env.local (mode 0600).
# Preserve existing secrets. Inherited process env wins; no DB_FILE_NAME fallback.
# CLI config/smoke load .env.local explicitly; Next uses its built-in server loader.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
TEST_DB_PASSWORD=
# App/migration/smoke only; required at first database use, not application import/build.
# postgresql://slotwell_app:<APP_DB_PASSWORD>@127.0.0.1:55432/slotwell_dev
DATABASE_URL=
# Separate explicit test handle only; never falls back to DATABASE_URL. Not used by units.
# No URL query/search_path overrides; no reset authorization is granted here.
# postgresql://slotwell_test:<TEST_DB_PASSWORD>@127.0.0.1:55432/slotwell_test
TEST_DATABASE_URL=
